generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  ESTATE
}

enum SolarInterest {
  RESIDENTIAL
  COMMERCIAL
  BATTERY
}

enum SubmissionStatus {
  PENDING
  CONTACTED
  QUALIFIED
  ARCHIVED
}

model ConsultationSubmission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String
  propertyType PropertyType     @default(RESIDENTIAL)
  interest     SolarInterest    @default(RESIDENTIAL)
  message      String?
  status       SubmissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([email])
  @@index([status])
}
